{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "moduleResolution": "node16"
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "allowJs": true,
  "noEmit": true,
  "checkJs": false
}
